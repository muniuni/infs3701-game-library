generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Game {
  id       String @id
  titleKey String @unique
  igdbId   Int? @unique
  steamAppId Int? @unique
  data     Json
  coverKey String? @unique
}

// Durable cover cleanup ledger. Pending uploads expire after one day.
model CoverObject {
  key       String @id
  state     String
  updatedAt DateTime @updatedAt
  @@index([state, updatedAt])
}

// Receipts make Steam retries safe after a lost response.
model SteamImportReceipt {
  id String @id
  fingerprint String
  gameId String
}
