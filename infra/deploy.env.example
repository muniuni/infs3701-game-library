# Copy to infra/deploy.env (gitignored) and fill in. Read only by infra/deploy.sh.
# Values become NoEcho stack parameters; the stack stores the API keys in
# Secrets Manager (docs/GROUP_ARCHITECTURE.md, D10 and D12).
# Plain KEY=value lines; quote a value that contains spaces or shell characters.

IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
STEAM_WEB_API_KEY=
# Receives the HealthyHostCount alarm. Confirm the subscription email after every rebuild.
ALERT_EMAIL=

# Optional (defaults shown).
# STACK_NAME=game-library
# AWS_REGION=us-east-1
