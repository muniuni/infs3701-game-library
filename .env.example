# Local development and local production-build testing.
STORAGE_MODE=local
# Use .env credentials locally, including local production-build testing.
SECRETS_SOURCE=env
# EC2: set SECRETS_SOURCE=aws (also the default in production).
# Secrets Manager uses us-east-1 and the EC2 role; see deploy/README.md.
# PostgreSQL. Default outside production: the Docker database in compose.yaml
# (start it with `docker compose up -d --wait`).
# DATABASE_URL=postgresql://game_library:game_library@localhost:5432/game_library
# Tests create disposable databases on this server; TEST_DATABASE_URL overrides it.
# STORAGE_MODE only chooses where covers live: local (files) or s3.
# Uploaded images default to data/covers/; no AWS setup is needed locally.
# LOCAL_COVERS_DIR can override this directory for isolated tests.
# AWS: STORAGE_MODE=s3 (the production default). DATABASE_URL is built at
# runtime from the RDS-managed secret and is never stored in a file.
# AWS_REGION=us-east-1
# S3_BUCKET=infs3701-game-library-images
# Use an EC2 instance role; do not store AWS access keys here.
# Optional IGDB autofill. Twitch application credentials stay on the server.
# IGDB_CLIENT_ID=<Twitch application client ID>
# IGDB_CLIENT_SECRET=<Twitch application client secret>

# Optional Steam library import. Keep this user Web API key server-only.
# Obtain it at https://steamcommunity.com/dev/apikey
# STEAM_WEB_API_KEY=<Steam Web API key>
# Steam account/profile is entered in the import dialog, not stored here.
