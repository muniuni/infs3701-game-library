# Local development and local production-build testing.
STORAGE_MODE=local
# Optional absolute path. Default: <repository>/data/game-library.sqlite
# DATABASE_URL=file:/absolute/path/game-library.sqlite
AWS_REGION=us-east-1
S3_BUCKET=infs3701-game-library-images
# EC2: use STORAGE_MODE=ebs, DATABASE_URL=file:/mnt/game-library-data/game-library.sqlite
# EBS_VOLUME_UUID=<filesystem UUID from lsblk -f>
# Use an EC2 instance role; do not store AWS access keys here.
